# Cargo build output, and the staged release artifacts.
/target/
/dist/

# Session bundles and recordings hold server logs. They never enter the
# repository (CLAUDE.md, "Rules that are not negotiable").
/bundles/
/recordings/

# Missions are not committed, except the test fixtures under tests/fixtures/templates/.
*.miz
!/tests/fixtures/templates/*.miz

# Target profiles live outside the repository, in ~/.config/nanoprobe/.
targets.toml

# Personal settings.
CLAUDE.local.md
.claude/settings.local.json
.DS_Store

# The fuzz targets' build output, corpora and crash artifacts.
/crates/transport/fuzz/target/
/crates/transport/fuzz/corpus/
/crates/transport/fuzz/artifacts/

# The Python hello campaign's generated gRPC code and virtual environment.
/examples/hello-python/gen/
/examples/hello-python/.venv/
__pycache__/

# The Kotlin hello campaign's build output and Gradle state.
/examples/hello-kotlin/build/
/examples/hello-kotlin/.gradle/
/examples/hello-kotlin/.kotlin/
/deploy/nanoprobe-sidecar
